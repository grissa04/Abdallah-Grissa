pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/grissa04/Abdallah-Grissa.git'
            }
        }

        stage('Compile') {
            steps {
                dir('backend') {
                    sh 'mvn compile'
                }
            }
        }

        stage('Build & Test Maven') {
            steps {
                dir('backend') {
                    sh 'mvn package'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('backend') {
                    sh 'docker build -t backend-app:latest .'
                    sh 'docker tag backend-app:latest grissa04/backend-app:latest'
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set +x
                        echo "$DOCKERHUB_TOKEN" | docker login -u "$DOCKERHUB_USERNAME" --password-stdin
                        trap 'docker logout' EXIT
                        docker push grissa04/backend-app:latest
                    '''
                }
            }
        }

        stage('Deploy MySQL') {
            steps {
                sh '''
                    docker network inspect backend-network >/dev/null 2>&1 || docker network create backend-network

                    if docker container inspect mysql >/dev/null 2>&1; then
                        docker start mysql
                        if [ "$(docker inspect -f '{{if index .NetworkSettings.Networks "backend-network"}}yes{{end}}' mysql)" != "yes" ]; then
                            docker network connect backend-network mysql
                        fi
                    else
                        docker run -d --name mysql \
                            --network backend-network \
                            -p 127.0.0.1:3306:3306 \
                            -e MYSQL_ROOT_PASSWORD=root \
                            -e MYSQL_DATABASE=test_db \
                            grissa04/mysql:v1
                    fi

                    for i in $(seq 1 60); do
                        if docker exec mysql mysql -h 127.0.0.1 -uroot -proot -e "SELECT 1" >/dev/null 2>&1; then
                            exit 0
                        fi
                        sleep 2
                    done

                    docker logs mysql
                    exit 1
                '''
            }
        }

        stage('Deploy Backend') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set +x
                        echo "$DOCKERHUB_TOKEN" | docker login -u "$DOCKERHUB_USERNAME" --password-stdin
                        trap 'docker logout' EXIT

                        docker stop backend-app || true
                        docker rm backend-app || true

                        docker pull grissa04/backend-app:latest

                        docker run -d --name backend-app \
                            --network backend-network \
                            -p 8081:8080 \
                            -e SPRING_DATASOURCE_URL='jdbc:mysql://mysql:3306/test_db?createDatabaseIfNotExist=true' \
                            -e SPRING_DATASOURCE_USERNAME=root \
                            -e SPRING_DATASOURCE_PASSWORD=root \
                            grissa04/backend-app:latest
                    '''
                }
            }
        }

        stage('Verification') {
            steps {
                sh '''
                    for i in $(seq 1 60); do
                        if [ "$(docker inspect -f '{{.State.Running}}' backend-app)" = "true" ] && docker logs backend-app 2>&1 | grep -q "Started BackendApplication"; then
                            docker ps
                            docker logs backend-app
                            exit 0
                        fi
                        sleep 2
                    done

                    docker ps -a
                    docker logs backend-app
                    exit 1
                '''
            }
        }
    }
}
